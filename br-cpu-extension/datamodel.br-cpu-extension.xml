            <methods>
                <method id="OnServerSetInitialAttributesFlagsReadOnlyCpuCount">
                    <static>false</static>
                    <access>public</access>
                    <type>EventListener</type>
                    <code><![CDATA[
    /**
    * Sets the cpu_count attribute to read-only when the object is initialized.
    * This prevents users from entering or modifying the value manually
    * when creating a new Server object.
    */
    public function OnServerSetInitialAttributesFlagsReadOnlyCpuCount(Combodo\iTop\Service\Events\EventData $oEventData)
    {
        $this->ForceInitialAttributeFlags('cpu_count', OPT_ATT_READONLY);
    }
  ]]></code>
                </method>
                <method id="OnServerSetAttributesFlagsReadOnlyCpuCount">
                    <static>false</static>
                    <access>public</access>
                    <type>EventListener</type>
                    <code><![CDATA[
    /**
    * Enforces the cpu_count attribute to remain read-only at all times.
    * The value is derived automatically and must not be edited by users.
    */
    public function OnServerSetAttributesFlagsReadOnlyCpuCount(Combodo\iTop\Service\Events\EventData $oEventData)
    {
        $this->ForceAttributeFlags('cpu_count', OPT_ATT_READONLY);
    }
  ]]></code>
                </method>
                <method id="OnServerComputeCpuCount">
                    <static>false</static>
                    <access>public</access>
                    <type>EventListener</type>
                    <code><![CDATA[
    /**
    * Computes derived attribute values for the Server object.
    * This listener is triggered whenever dependent attributes change
    * or when the object is refreshed.
    */
    public function OnServerComputeCpuCount(Combodo\iTop\Service\Events\EventData $oEventData)
    {
        $this->SetCpuCount();
    }
  ]]></code>
                </method>
                <method id="SetCpuCount" _delta="define">
                    <static>false</static>
                    <access>public</access>
                    <type>Overload-DBObject</type>
                    <code><![CDATA[
    /**
    * Computes the total CPU count based on sockets and cores.
    *
    * cpu_count is a derived, read-only attribute.
    * It is stored as a string on purpose to allow future formatting
    * (e.g. "2×12 (24)", "n/a", etc.).
    *
    * Rules:
    * - If either cpu_sockets or cpu_cores is NULL, cpu_count is set to NULL
    * - If values are invalid (<= 0), cpu_count is set to NULL
    * - Otherwise: cpu_count = cpu_sockets * cpu_cores
    */
    public function SetCpuCount()
    {
        $iSockets = $this->Get('cpu_sockets');
        $iCores   = $this->Get('cpu_cores');

        // If one of the required values is missing, the CPU count is unknown
        if ($iSockets === null || $iCores === null) {
            $this->Set('cpu_count', null);
            return;
        }

        // Normalize values to integers
        $iSockets = (int) $iSockets;
        $iCores   = (int) $iCores;

        // Reject invalid values
        if ($iSockets <= 0 || $iCores <= 0) {
            $this->Set('cpu_count', null);
            return;
        }

        // Store the computed value as string (by design)
        $this->Set('cpu_count', (string) ($iSockets * $iCores));
    }
  ]]></code>
                </method>
