    <classes>
        <class id="Server" _delta="must_exist">
            <fields>
                <field id="cpu_sockets" xsi:type="AttributeInteger" _delta="define">
                    <sql>cpu_sockets</sql>
                    <is_null_allowed>true</is_null_allowed>
                </field>
                <field id="cpu_cores" xsi:type="AttributeInteger" _delta="define">
                    <sql>cpu_cores</sql>
                    <is_null_allowed>true</is_null_allowed>
                </field>
                <field id="cpu_count" xsi:type="AttributeString" _delta="define">
                    <sql>cpu_count</sql>
                    <is_null_allowed>true</is_null_allowed>
                </field>
            </fields>
            <event_listeners>
                <event_listener id="EvtSetInitialAttributeFlagsHideCpuCount">
                    <event>EVENT_DB_SET_INITIAL_ATTRIBUTES_FLAGS</event>
                    <rank>10</rank>
                    <callback>EvtSetInitialAttributeFlagsHideCpuCount</callback>
                </event_listener>
                <event_listener id="EvtSetAttributeFlagsReadOnlyCpuCount">
                    <event>EVENT_DB_SET_ATTRIBUTES_FLAGS</event>
                    <rank>10</rank>
                    <callback>EvtSetAttributeFlagsReadOnlyCpuCount</callback>
                </event_listener>
                <event_listener id="EvtBeforeWriteSetCpuCount">
                    <event>EVENT_DB_BEFORE_WRITE</event>
                    <rank>10</rank>
                    <callback>EvtBeforeWriteSetCpuCount</callback>
                </event_listener>
            </event_listeners>
            <methods>
                <method id="EvtSetInitialAttributeFlagsHideCpuCount">
                    <static>false</static>
                    <access>public</access>
                    <type>EventListener</type>
                    <code><![CDATA[
    public function EvtSetInitialAttributeFlagsHideCpuCount(Combodo\iTop\Service\Events\EventData $oEventData)
    {
        $this->ForceInitialAttributeFlags('cpu_count', OPT_ATT_HIDDEN);
    }
  ]]></code>
                </method>
                <method id="EvtSetAttributeFlagsReadOnlyCpuCount">
                    <static>false</static>
                    <access>public</access>
                    <type>EventListener</type>
                    <code><![CDATA[
    public function EvtSetAttributeFlagsReadOnlyCpuCount(Combodo\iTop\Service\Events\EventData $oEventData)
    {
        $this->ForceAttributeFlags('cpu_count', OPT_ATT_READONLY);
    }
  ]]></code>
                </method>
                <method id="EvtBeforeWriteSetCpuCount">
                    <static>false</static>
                    <access>public</access>
                    <type>EventListener</type>
                    <code><![CDATA[
    public function EvtBeforeWriteSetCpuCount(Combodo\iTop\Service\Events\EventData $oEventData)
    {
        $this->SetCpuCount();
    }
  ]]></code>
                </method>
                <method id="SetCpuCount" _delta="define">
                    <static>false</static>
                    <access>public</access>
                    <type>Overload-DBObject</type>
                    <code><![CDATA[
    public function SetCpuCount()
    {
        // read the new value of the CPU
        $iSockets = $this->Get('cpu_sockets');
        $iCores = $this->Get('cpu_cores');
        $iTotal = $iSockets * $iCores;

        $this->Set('cpu_count', $iTotal);
    }
  ]]></code>
                </method>
            </methods>
